#!/bin/bash
check_commands meson ninja "$CC" "$CXX"

if [[ "$OSTYPE" == "linux"* || "$OSTYPE" == "freebsd"* ]]; then
    declare_dependency x11
    declare_dependency xext
    for depname in xrandr xrender xfixes xcursor xi; do
        declare_dependency --optional "$depname"
    done
fi

options=()
xft_option="-Dxft=false"
apps_option="-Dapps=false"
while [ ! -z ${1+x} ]; do
    case $1 in
    -jpeg)
        options+=("-Djpeg=true")
        declare_dependency libjpeg
        ;;
    -opengl)
        options+=("-Dopengl=true")
        ;;
    -png)
        options+=("-Dpng=true")
        declare_dependency libpng
        ;;
    -zlib)
        options+=("-Dzlib=true")
        declare_dependency zlib
        ;;
    -bzlib)
        options+=("-Dbzlib=true")
        # Not able to detect a dependency without pkg-config file
        # dependency bz2
        ;;
    -xft)
        xft_option="-Dxft=true"
        declare_dependency freetype2
        declare_dependency xft
        ;;
    -apps)
        apps_option="-Dapps=true"
        ;;
    *)
        options+=("$1")
        ;;
    esac
    shift
done

enter_git_repository https://github.com/franko/fox.git "v${version}-lhelper"
build_and_install meson "$xft_option" "$apps_option" "${options[@]}"
